# public/app.js 의 USE_PROXY 가 true 일 때(기본값) 서버가 읽는 값들.
# 이 파일을 .env 로 복사해 채운 뒤 `node --env-file=.env server.js` 로 실행한다.
# (.env 는 .gitignore 에 걸려 있어 커밋되지 않는다)
#
# Vercel 에 배포할 때는 같은 이름으로 프로젝트 환경 변수에 등록한다.

AZURE_ENDPOINT=https://<리소스>.openai.azure.com/openai/deployments/<배포이름>/chat/completions?api-version=2024-10-21
AZURE_API_KEY=

# 선택 — 설정하면 /api/analyze 가 이 코드를 아는 사람만 받는다.
# 비워 두면 게이트가 없다(로컬 개발 기본값).
# 공개 URL 로 배포한다면 설정을 권한다. 아무나 호출해 Azure 쿼터를 소모할 수 있다.
ACCESS_CODE=
