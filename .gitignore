# ── 의존성 ──────────────────────────────────────────────────────────
# package-lock.json 은 커밋한다(무시하지 않는다). 설치 버전을 고정해야
# 다른 사람이 같은 트리를 받는다.
node_modules/
.npm/
.pnpm-store/
.yarn/

# ── 자격증명 ────────────────────────────────────────────────────────
# server.js 는 AZURE_ENDPOINT / AZURE_API_KEY 를 process.env 에서 읽는다.
# .env 로 주입할 경우 절대 커밋되지 않도록 막는다.
.env
.env.*
!.env.example

# ── 로그 ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── 테스트용 미디어 ─────────────────────────────────────────────────
# 개발 중 public/ 에 임시로 떨어뜨리는 샘플 영상. 이 앱은 영상을 서버에
# 두지 않으므로 여기 들어오는 미디어는 전부 일회용 테스트 파일이다.
# (500MB 짜리를 실수로 커밋하면 되돌리기가 매우 번거롭다)
public/__test_*
*.webm
*.mp4
*.mov
*.mkv

# ── 에디터 / 도구 ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# .claude/launch.json 은 커밋한다(팀 공용 실행 설정).
# 개인 설정만 제외한다.
.claude/settings.local.json

# ── OS ──────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
